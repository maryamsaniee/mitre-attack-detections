# Detects execution of hh.exe, the Windows HTML Help executable, which may be abused to execute malicious CHM content.
# MITRE ATT&CK Technique: T1218.001 - Compiled HTML File
# Tactic: Defense Evasion (TA0005)
# Review before publication: validate Sysmon Event ID 1 field mappings and investigate suspicious command-line arguments.

index=windows_logs sourcetype=Sysmon EventCode=1
| where like(lower(Image), "%\\hh.exe")
| table _time host User Image CommandLine ParentImage
