# Detects attempts to disable or modify Windows event logging.
# MITRE ATT&CK Techniques: T1562.002 - Disable Windows Event Logging; T1070.001 - Clear Windows Event Logs
# Tactic: Defense Evasion (TA0005)
# Review before publication: validate event IDs and field mappings against the available Windows logs.

index=windows_logs
(
    ((EventCode=4688 OR EventCode=1)
        ((CommandLine="*New-Item*" OR CommandLine="*reg add*")
            CommandLine="*MiniNt*")
    )
    OR (CommandLine="*Stop-Service*" CommandLine="*EventLog*")
    OR (CommandLine="*EventLog*"
        (CommandLine="*Set-Service*"
        OR CommandLine="*reg add*"
        OR CommandLine="*Set-ItemProperty*"
        OR CommandLine="*New-ItemProperty*"
        OR CommandLine="*sc config*"))
    OR (CommandLine="*auditpol*"
        (CommandLine="*/set*" OR CommandLine="*/clear*"
        OR CommandLine="*/revove*"))
    OR (CommandLine="*wevtutil*"
        (CommandLine="*sl*" OR CommandLine="*set-log*"))
    OR EventCode=4719
    OR ((EventCode=4657 OR EventCode=13)
        ObjectName="*EventLog*"
        (ObjectValueName="Start" OR ObjectValueName="File"
        OR ObjectValueName="MaxSize"))
)
| table _time host user EventCode Image CommandLine ObjectName ObjectValueName
