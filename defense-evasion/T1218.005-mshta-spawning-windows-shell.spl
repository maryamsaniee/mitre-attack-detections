# Detects shell or scripting processes spawned by mshta.exe, which may indicate suspicious use of the Microsoft HTML Application Host.
# MITRE ATT&CK Technique: T1218.005 - Mshta
# Tactic: Defense Evasion (TA0005)
# Review before publication: validate Sysmon Event ID 1 field mappings and macro dependencies.

`sysmon` EventCode=1 ParentImage="*\\mshta.exe"
(Image="*\\cmd.exe" OR Image="*\\powershell.exe" OR Image="*\\wscript.exe" OR Image="*\\cscript.exe" OR Image="*\\sh.exe" OR Image="*\\bash.exe")
| table _time host User ParentImage Image CommandLine
