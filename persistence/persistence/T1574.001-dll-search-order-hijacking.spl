# Detects attempts to disable Safe DLL Search Mode.
# MITRE ATT&CK Technique: T1574.001 - DLL Search Order Hijacking
# Tactic: Persistence (TA0003)
# Review before publication: validate event IDs and field mappings against the available Windows logs.

index=wineventlog
(
    (
        (EventCode=4688 OR EventCode=1)
        (
            (CommandLine="*reg*" AND CommandLine="*add*" AND CommandLine="*/d*")
            OR
            (CommandLine="*Set-ItemProperty*" AND CommandLine="*-value*")
        )
        AND CommandLine="*SafeDllSearchMode*"
        AND (CommandLine="*00000000*" OR CommandLine="* 0*")
    )
    OR
    (
        EventCode=4657
        ObjectValueName="SafeDllSearchMode"
        value="0"
    )
    OR
    (
        EventCode=13
        EventType="SetValue"
        TargetObject="*SafeDllSearchMode"
        Details="DWORD (0x00000000)"
    )
)
| table _time host user EventCode EventType TargetObject Details CommandLine ObjectValueName value
