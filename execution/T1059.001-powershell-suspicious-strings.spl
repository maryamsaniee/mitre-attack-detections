# Detects PowerShell process events containing command-line patterns such as Invoke, IEX, or Download.
# MITRE ATT&CK Technique: T1059.001 - PowerShell
# Tactic: Execution (TA0002)
# Review before publication: validate Sysmon field mappings and test for false positives.

index=windows_logs sourcetype=Sysmon EventCode=1
| where like(lower(process), "%powershell.exe%")
    AND (
        like(lower(CommandLine), "%invoke%")
        OR like(lower(CommandLine), "%iex%")
        OR like(lower(CommandLine), "%download%")
    )
| table _time host ProcessID process CommandLine ParentProcessId ParentImage ParentCommandLine
