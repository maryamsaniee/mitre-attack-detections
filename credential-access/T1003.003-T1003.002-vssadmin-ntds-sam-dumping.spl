# Detects commands associated with accessing NTDS.dit or SAM data through shadow copies and registry exports.
# MITRE ATT&CK Technique: T1003.003 - NTDS
# MITRE ATT&CK Technique: T1003.002 - Security Account Manager
# Review before publication: validate Sysmon Event ID 1 field mappings and command-line matching against actual events.

index=wineventlog sourcetype=Sysmon EventCode=1 (CommandLine="vssadmin.exe Delete Shadows" OR CommandLine="vssadmin create shadow /for=C:" OR CommandLine="copy \\\\?\\GLOBALROOT\\Device\\windows\\ntds\\ntds.dit" OR CommandLine="copy \\?\\GLOBALROOT\\Device\\*\\config\\SAM" OR CommandLine="vssadmin delete shadows /for=C:" OR CommandLine="reg SAVE HKLM\\SYSTEM "
