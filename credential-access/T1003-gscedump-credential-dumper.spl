# Detects activity associated with Gsecdump, a tool that can extract credential material from Windows systems.
# MITRE ATT&CK Tactic: Credential Access
# Review before publication: verify the original SPL, Sysmon field mappings, and false positives.

index=windows_logs sourcetype=Sysmon EventCode=1
| where like(lower(Image), "%gsecdump%") OR like(lower(CommandLine), "%gsecdump%")
| table _time host User Image CommandLine ParentImage
