# Detects potential execution of Gsecdump, a tool associated with dumping Windows SAM password hashes and LSA secrets.
# MITRE ATT&CK Techniques: T1003.002, T1003.004
# Tactic: Credential Access (TA0006)
# Review before publication: verify the original SPL and process-creation field mappings.
index=windows_logs sourcetype=Sysmon EventCode=1
| where like(lower(Image), "%gsecdump%")
    OR like(lower(CommandLine), "%gsecdump%")
| table _time host User Image CommandLine ParentImage
