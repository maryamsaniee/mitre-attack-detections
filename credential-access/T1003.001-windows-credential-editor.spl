
# Detects execution of Windows Credential Editor (wce.exe), which may be used to extract credentials.
# MITRE ATT&CK Technique: T1003.001
# Tactic: Credential Access
# Review before publication: validate Sysmon process-creation fields and test for false positives.

index=windows_logs sourcetype=Sysmon EventCode=1
| where like(lower(Image), "%\\wce.exe") OR like(lower(CommandLine), "%wce.exe%")
| table _time host Computer User Image CommandLine ParentImage
