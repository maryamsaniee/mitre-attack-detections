
# Detects execution of Windows Credential Editor (WCE), which may be used for credential dumping.
# MITRE ATT&CK Technique: T1003.001 - LSASS Memory
# Tactic: Credential Access (TA0006)
# Review before publication: validate Sysmon Event ID 1 fields, executable naming, and false positives.

index=windows_logs sourcetype=Sysmon EventCode=1
| where like(lower(Image), "%\\wce.exe") OR like(lower(CommandLine), "%wce.exe%")
| table _time host Computer User Image CommandLine ParentImage
